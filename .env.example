# Environment variables the Lambdas read. In deployment these are INJECTED BY
# TERRAFORM (terraform/infra) — this file exists for reference and local testing
# only. Never commit a file with real values.

# ── Shared ───────────────────────────────────────────────────────────────────
REGION=                          # AWS region the Lambdas run in (e.g. us-east-2)
DISCORD_BOT_TOKEN_SECRET_NAME=   # Secrets Manager secret NAME holding the bot token (value fetched at runtime)

# ── Main bot Lambda (src/) ───────────────────────────────────────────────────
PUBLIC_KEY=                      # Discord application public key for interaction signature verification
DEFERRED_WORKER_QUEUE_URL=       # SQS queue URL for commands that cannot finish inside Discord's 3s deadline

# ── Deferred worker Lambda (jobs/deferred_worker) ────────────────────────────
STARTGG_API_KEY_SECRET_NAME=     # Secrets Manager secret NAME holding the start.gg API key
MATCHMAKING_ROLE_IDS=            # JSON {"novice": "<id>", "fighter": ..., "ascended": ..., "elite": ...}; set from terraform/infra/matchmaking_roles.tf (bot Lambda too)
NOVICE_CHANNEL_ID=               # Channel Novice players are pointed to; set from terraform/infra/matchmaking_roles.tf
